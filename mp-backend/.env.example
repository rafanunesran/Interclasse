# Copie estas variáveis para a Vercel (Project Settings > Environment Variables).
# NÃO comite valores reais — este arquivo é só um modelo.

# Mercado Pago (Suas integrações > sua aplicação)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx      # Access Token (use o de TESTE para testar, produção para valer)
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx            # Secret gerado ao configurar o Webhook

# Firebase (Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada)
FIREBASE_PROJECT_ID=interclasse-e2854
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@interclasse-e2854.iam.gserviceaccount.com
# Cole a private_key inteira entre aspas; mantenha os \n como estão no JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Opcional: restringe o CORS à origem do seu site (senão libera para todos)
# SITE_ORIGIN=https://SEU-USUARIO.github.io

# Opcional: e-mail usado como "pagador" nas cobranças PIX (só formato, não precisa ser real)
# MP_EMAIL_PAGADOR=pagador@interclasse.app
