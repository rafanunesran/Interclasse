rules_version = '2';

// ============================================================
// REGRAS DE SEGURANÇA DO FIRESTORE
// Cole este conteúdo em: Firebase Console > Firestore Database
// > Regras, e clique em "Publicar".
//
// Modelo adotado:
// - Leitura: pública (qualquer pessoa com o link pode ver a lista,
//   para permitir a conferência do pedido).
// - Alunos e o "fechar pedido" dos times: exigem estar autenticado
//   (login anônimo automático do site). A senha do time é conferida no
//   site (JavaScript) — é uma barreira de conveniência, não um sigilo.
// - Ações administrativas (criar clientes e times, editar tamanhos e
//   configurações): exigem estar logado com a conta administradora
//   (e-mail/senha do Firebase Authentication). Ver ehAdmin() abaixo.
// - Exclusão de aluno é sempre "suave" (campo excluido = true),
//   nunca um delete de verdade — por isso "delete" é bloqueado.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Verdadeiro apenas para a conta administradora (master), logada por
    // e-mail/senha no Firebase Authentication. Mantenha este e-mail igual
    // ao MASTER_EMAIL definido em js/admin.js.
    function ehAdmin() {
      return request.auth != null
        && request.auth.token.email == "rafaelnf93@gmail.com";
    }

    // Documentos de configuração do site (config/...).
    // - config/geral e config/tamanhos: só o admin pode gravar.
    match /config/{docId} {
      allow read: if true;
      allow create, update: if ehAdmin() && (docId == "geral" || docId == "tamanhos");
      allow delete: if false;
    }

    // Clientes: cada cliente agrupa os seus próprios times/pedidos.
    // Leitura pública (a tela inicial lista os clientes); só o admin grava.
    match /clientes/{clienteId} {
      allow read: if true;
      allow create, update, delete: if ehAdmin();
    }

    // Cobranças do Mercado Pago (uma cobrança pode ter várias camisetas,
    // quando o pagador junta o carrinho). Só o backend na Vercel escreve e lê
    // aqui, pelo Admin SDK, que não passa por estas regras — então o site
    // fica sem nenhum acesso: ninguém consegue forjar uma cobrança paga.
    match /cobrancas/{cobrancaId} {
      allow read, write: if false;
    }

    // Levas de produção (aba Produção do Super Admin): o que foi escolhido
    // para ir à impressão de uma vez, incluindo camisetas avulsas que não
    // estão em nenhum pedido. É controle interno da produção, então nem a
    // leitura é pública: só a conta administradora entra aqui.
    match /producao/{levaId} {
      allow read, write: if ehAdmin();

      match /itens/{itemId} {
        allow read, write: if ehAdmin();
      }
    }

    // Artes de produção (aba Artes do Super Admin): moldes, partes da arte,
    // fontes e posições do nome/número de cada modelo. Controle interno,
    // como as levas: só a conta administradora lê e grava.
    match /artes/{arteId} {
      allow read, write: if ehAdmin();
    }

    // Times (a coleção continua com o nome antigo, "turmas", para não
    // quebrar os dados já cadastrados — ver COL_TIMES em js/utils.js).
    match /turmas/{timeId} {
      allow read: if true;
      // Criar/excluir time é ação administrativa; atualizar (ex.: fechar/
      // reabrir o pedido) pode ser feito pelo representante autenticado.
      allow create: if ehAdmin();
      allow update: if request.auth != null;
      allow delete: if ehAdmin();

      match /alunos/{alunoId} {
        allow read: if true;
        allow create, update: if request.auth != null;
        // Exclusão de aluno pelo representante continua "suave" (excluido=true).
        // O delete de verdade só acontece quando o admin exclui o time inteiro.
        allow delete: if ehAdmin();
      }
    }
  }
}
