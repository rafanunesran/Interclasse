rules_version = '2';

// ============================================================
// REGRAS DE SEGURANÇA DO FIRESTORE
// Cole este conteúdo em: Firebase Console > Firestore Database
// > Regras, e clique em "Publicar".
//
// Modelo adotado:
// - Leitura: pública (qualquer pessoa com o link pode ver a lista,
//   para permitir a conferência do pedido).
// - Alunos e o "fechar pedido" das turmas: exigem estar autenticado
//   (login anônimo automático do site). A senha da turma é conferida no
//   site (JavaScript) — é uma barreira de conveniência, não um sigilo.
// - Ações administrativas (criar turmas, editar tamanhos e configurações):
//   exigem estar logado com a conta administradora (e-mail/senha do
//   Firebase Authentication). Ver a função ehAdmin() abaixo.
// - Exclusão de aluno é sempre "suave" (campo excluido = true),
//   nunca um delete de verdade — por isso "delete" é bloqueado.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Verdadeiro apenas para a conta administradora (master), logada por
    // e-mail/senha no Firebase Authentication. Mantenha este e-mail igual
    // ao MASTER_EMAIL definido em js/admin.js.
    function ehAdmin() {
      return request.auth != null
        && request.auth.token.email == "rafaelnf93@gmail.com";
    }

    // Documentos de configuração do site (config/...).
    // - config/geral e config/tamanhos: só o admin pode gravar.
    match /config/{docId} {
      allow read: if true;
      allow create, update: if ehAdmin() && (docId == "geral" || docId == "tamanhos");
      allow delete: if false;
    }

    match /turmas/{turmaId} {
      allow read: if true;
      // Criar/excluir turma é ação administrativa; atualizar (ex.: fechar/
      // reabrir o pedido) pode ser feito pelo representante autenticado.
      allow create: if ehAdmin();
      allow update: if request.auth != null;
      allow delete: if ehAdmin();

      match /alunos/{alunoId} {
        allow read: if true;
        allow create, update: if request.auth != null;
        // Exclusão de aluno pelo representante continua "suave" (excluido=true).
        // O delete de verdade só acontece quando o admin exclui a turma inteira.
        allow delete: if ehAdmin();
      }
    }
  }
}
